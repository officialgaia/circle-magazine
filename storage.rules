rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        firestore.get(/databases/(default)/documents/config/adminEmails)
          .data.adminEmails.hasAny([request.auth.token.email]);
    }

    // 名簿の行 rosterId を、今このブラウザ(uid)が「自分」として選んでいるか。
    function ownsRoster(issueId, rosterId) {
      return isSignedIn() &&
        firestore.get(
          /databases/(default)/documents/issues/$(issueId)/roster/$(rosterId)
        ).data.claimedByUid == request.auth.uid;
    }

    // 投稿された生ファイル。名簿の行のIDでフォルダを分け、
    // その行を選んでいる本人と管理者のみ読み書きできるようにする(他人の生ファイルはDL不可)。
    match /issues/{issueId}/submissions/{rosterId}/{fileName} {
      allow read: if isAdmin() || ownsRoster(issueId, rosterId);
      allow write: if ownsRoster(issueId, rosterId) &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
        );
      allow delete: if isAdmin() || ownsRoster(issueId, rosterId);
    }

    // 完成した冊子セクションのPDF。セクションIDでフォルダを分け、
    // Firestore側のドキュメント(locked / ownerRosterId)を参照して、
    // 非公開セクションのファイルは投稿者本人と管理者にしか読めないようにする。
    match /issues/{issueId}/booklet/{sectionId}/{fileName} {
      function section() {
        return firestore.get(
          /databases/(default)/documents/issues/$(issueId)/booklet/$(sectionId)
        ).data;
      }

      allow read: if isAdmin() ||
        (isSignedIn() && section().locked == false) ||
        (isSignedIn() && section().ownerRosterId != null &&
          ownsRoster(issueId, section().ownerRosterId));
      allow write: if isAdmin() &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
