rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 匿名認証も含め、Firebase Authのセッションを持っていれば true。
    // 一般メンバーはログイン画面を見ないが、裏側で自動的に匿名セッションが
    // 割り当てられるため、実質的にアプリの正規のクライアントからのみ true になる。
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/adminEmails).data.adminEmails;
    }

    // 管理者メール一覧。閲覧はログインユーザーのみ、書き込みは
    // コンソール／サーバー側から直接行う運用とし、クライアントからは変更不可にする。
    match /config/adminEmails {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // 投稿された生ファイルの情報。1人1件まで(ドキュメントID=投稿者のuid)。
      // 本人と管理者のみ閲覧できる。本人判定はドキュメントIDで行う。
      // (resource.data で判定すると、まだ投稿していない人が自分の投稿の有無を
      //  確認しようとした時点で resource が存在せず権限エラーになるため)
      match /submissions/{submissionId} {
        allow read: if isAdmin() ||
          (isSignedIn() && submissionId == request.auth.uid);
        allow create: if isSignedIn() &&
          submissionId == request.auth.uid &&
          request.resource.data.submitterUid == request.auth.uid &&
          request.resource.data.format in ['pdf', 'docx'];
        allow update: if isAdmin() || (
          isSignedIn() &&
          submissionId == request.auth.uid &&
          request.resource.data.submitterUid == request.auth.uid &&
          request.resource.data.format in ['pdf', 'docx']
        );
        allow delete: if isAdmin();
      }

      // 完成した冊子セクション。非公開(locked)のセクションは、
      // 投稿者本人(ownerUid)と管理者にしか見えない。編集は管理者のみ。
      match /booklet/{sectionId} {
        allow read: if isAdmin() ||
          (isSignedIn() && resource.data.locked == false) ||
          (isSignedIn() && resource.data.ownerUid == request.auth.uid);
        allow write: if isAdmin();
      }

      // 名簿。閲覧はメンバー全員(匿名可)。
      // 「自分の行」は claimedByUid で識別する(ログイン画面の代わり)。
      // 未選択の行を自分の行として選ぶ、または既に自分の行になっている場合のみ、
      // submitted・claimedByUid を更新できる(投稿時の自動チェックと本人選択用)。
      match /roster/{rosterId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isSignedIn() &&
          (
            resource.data.claimedByUid == request.auth.uid ||
            (resource.data.claimedByUid == null &&
              request.resource.data.claimedByUid == request.auth.uid)
          ) &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['submitted', 'claimedByUid'])
        );
      }
    }
  }
}
