rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 匿名認証も含め、Firebase Authのセッションを持っていれば true。
    // 一般メンバーはログイン画面を見ないが、裏側で自動的に匿名セッションが
    // 割り当てられるため、実質的にアプリの正規のクライアントからのみ true になる。
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email != null &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/adminEmails).data.adminEmails;
    }

    // 管理者メール一覧。閲覧はログインユーザーのみ、書き込みは
    // コンソール／サーバー側から直接行う運用とし、クライアントからは変更不可にする。
    match /config/adminEmails {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // 名簿の行 rosterId を、今このブラウザ(uid)が「自分」として選んでいるか。
      // 本人識別はすべてこれに基づく(uidそのものには紐づけない)。
      function ownsRoster(rosterId) {
        return isSignedIn() &&
          get(/databases/$(database)/documents/issues/$(issueId)/roster/$(rosterId))
            .data.claimedByUid == request.auth.uid;
      }

      // 投稿された生ファイルの情報。1人1件まで(ドキュメントID=名簿の行のID)。
      // その行を選んでいる本人と管理者のみ閲覧できる。ブラウザの保存が消えて
      // uidが変わっても、名簿で同じ名前を選び直せば再び自分の投稿として扱われる。
      match /submissions/{submissionId} {
        allow read: if isAdmin() || ownsRoster(submissionId);
        allow create: if ownsRoster(submissionId) &&
          request.resource.data.rosterId == submissionId &&
          request.resource.data.submitterUid == request.auth.uid &&
          request.resource.data.format in ['pdf', 'docx'];
        allow update: if isAdmin() || (
          ownsRoster(submissionId) &&
          request.resource.data.rosterId == submissionId &&
          request.resource.data.submitterUid == request.auth.uid &&
          request.resource.data.format in ['pdf', 'docx']
        );
        allow delete: if isAdmin();
      }

      // 完成した冊子セクション。項目(タイトルなど)は非公開(locked)のものも
      // 含めて全員に見える。非公開セクションのPDF本体は Storage ルール側で
      // 投稿者本人と管理者以外には読めないようにしている。編集は管理者のみ。
      match /booklet/{sectionId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      // 名簿。閲覧はメンバー全員(匿名可)。
      // 「自分の行」は claimedByUid で識別する(ログイン画面の代わり)。
      // 自分の行として選ぶ(既に別のuidが選んでいる行も、引き継ぎのため選び直せる)、
      // または既に自分の行になっている場合のみ、submitted・claimedByUid を更新できる。
      match /roster/{rosterId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isSignedIn() &&
          (
            resource.data.claimedByUid == request.auth.uid ||
            request.resource.data.claimedByUid == request.auth.uid
          ) &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['submitted', 'claimedByUid'])
        );
      }
    }
  }
}
